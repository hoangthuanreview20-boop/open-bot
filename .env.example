# open-bot — mẫu biến môi trường.
# Sao chép thành `.env` nếu bạn muốn dùng file env, NHƯNG cách chính thức
# là nhập key trong Settings của app desktop (key chỉ lưu local, không
# bao giờ commit). Để trống các giá trị dưới đây — đừng điền key thật vào
# file này, và đừng commit file `.env` (đã có trong .gitignore).
#
# Copy to `.env` if you want env-file config, but the supported way is to
# enter keys in the desktop app's Settings (stored locally only). Leave
# the values empty here — never put a real key in this file, and never
# commit `.env` (it is gitignored).

# OpenAI — https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Anthropic (Claude) — https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Google Gemini — https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# xAI (Grok) — https://console.x.ai/
XAI_API_KEY=

# Ollama chạy local — thường không cần key.
# Ollama runs locally — usually no key needed.
OLLAMA_BASE_URL=http://localhost:11434/v1

# Endpoint tương thích OpenAI tùy chỉnh (nếu dùng provider khác).
# Custom OpenAI-compatible endpoint (if you use another provider).
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=
