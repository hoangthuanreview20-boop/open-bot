# Dependencies
node_modules/

# Build outputs
dist/
out/
build/
release/

# Logs
*.log
logs/

# Environment / secrets — API keys stay local only
.env
.env.*

# OS
.DS_Store
Thumbs.db

# Local databases (chat history, memory)
*.sqlite
*.sqlite-journal
*.sqlite-wal
*.sqlite-shm
*.db

# App data (Electron userData, caches)
app-data/
*.code-workspace

# Coverage / test artifacts
coverage/
.nyc_output/

# Smoke evidence scratch (v0.93b): scripts/smoke-*.mjs write their
# screenshots/summary.json here by default so a normal full-suite run
# never dirties the tree. The committed snapshot under docs/ is only
# refreshed with SMOKE_EVENTLOG_REFRESH=1 (explicit, intentional).
.smoke-scratch/

# Editor / tooling
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*.swo
